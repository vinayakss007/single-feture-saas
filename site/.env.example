# abetworks.in — the banner site.
#
# Nothing is required. With an empty file it builds and links every product at
# https://<slug>.abetworks.in.

# This site's own origin. Used for canonical tags and Open Graph. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://abetworks.in

# Apex that product subdomains hang off. Change this to repoint all ten at once —
# a staging apex, or a local setup — without editing any links.
NEXT_PUBLIC_PRODUCT_DOMAIN_BASE=abetworks.in

# Override a single product's URL. Needed during a launch when nine products are
# live on the real domain and the tenth is still on a preview URL.
# NEXT_PUBLIC_PRODUCT_URL_DEALBRIEF=https://dealbrief-xyz.vercel.app

# Shown as the contact address in the footer and the enterprise CTA.
NEXT_PUBLIC_CONTACT_EMAIL=hello@abetworks.in

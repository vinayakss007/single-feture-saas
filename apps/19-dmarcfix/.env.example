# =============================================================================
# Abet Works single-feature SaaS — environment
#
# Nothing here is required to boot. With an empty file the product runs in DEMO
# MODE: the landing page and the live demo work, metered by IP, with no accounts,
# keys or billing. Add DATABASE_URL and it becomes the full product.
#
# Every value below is obtainable on a free tier. See FRAMEWORK.md for the table
# of providers and the deployment checklist.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Site  (required in production)
# -----------------------------------------------------------------------------
# Used for canonical tags, Open Graph, payment redirect URLs and email links.
# No trailing slash. Get this wrong and password-reset links point at localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shown on /api/health so you can tell which build is live.
APP_VERSION=1.0.0

# Where "manage my subscription" mails go when the provider has no portal.
SUPPORT_EMAIL=support@abetworks.in

# -----------------------------------------------------------------------------
# 2. Database  (unlocks accounts, API keys, billing, metering)
# -----------------------------------------------------------------------------
# Postgres. Free options: Neon (neon.tech) or Supabase. Serverless platforms need
# the POOLED connection string, not the direct one.
# One database serves all ten products — rows are scoped by product slug — so a
# customer signs up once and that account works across the whole suite.
# The schema in db/schema.sql applies itself on first use.
# DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Set to "true" only if your provider presents a self-signed certificate.
# PGSSL_NO_VERIFY=false

# -----------------------------------------------------------------------------
# 3. Payments  (needed to take money — Razorpay OR Stripe, or both)
# -----------------------------------------------------------------------------
# Razorpay is the default when both are configured: UPI and INR, which is what
# Indian customers actually pay with. Stripe covers everyone else.
#
# Razorpay: dashboard.razorpay.com → Settings → API Keys, then create a
# Subscription Plan per product and paste its plan_… id below.
# RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_PLAN_dmarcfix_PRO=plan_xxxxxxxx
# RAZORPAY_PLAN_dmarcfix_ENTERPRISE=plan_xxxxxxxx

# Stripe: dashboard.stripe.com → Developers → API keys, then create a recurring
# Price per product and paste its price_… id below.
# STRIPE_SECRET_KEY=sk_live_xxxxxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx
# STRIPE_PRICE_dmarcfix_PRO=price_xxxxxxxx
# STRIPE_PRICE_dmarcfix_ENTERPRISE=price_xxxxxxxx

# Force a provider even when both are set. Leave unset to use the default.
# PAYMENTS_PROVIDER=razorpay

# Point both providers' webhooks at:  https://your-domain/api/billing/webhook
# Razorpay events:  subscription.activated, .charged, .halted, .cancelled, .completed
# Stripe events:    checkout.session.completed, customer.subscription.*,
#                   invoice.payment_failed

# -----------------------------------------------------------------------------
# 4. Email  (password resets, welcome, dunning)
# -----------------------------------------------------------------------------
# Resend free tier is 3,000/month. Without a key the app still works and the
# reset link is written to the logs rather than silently discarded.
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=Product Name <hello@your-domain.com>

# -----------------------------------------------------------------------------
# 5. Quotas and limits
# -----------------------------------------------------------------------------
# Runs a day allowed with no account, per IP. Keeps the launch-day demo usable
# without leaving it free to farm.
ANON_DAILY_LIMIT=15

# Overrides the per-plan rate limit for every caller. Leave UNSET in production so
# each plan gets its own limit from lib/plans.ts. 0 disables burst limiting.
# RATE_LIMIT_PER_MIN=

# Longest accepted value for any single input field.
MAX_FIELD_CHARS=20000

# -----------------------------------------------------------------------------
# 6. Monitoring
# -----------------------------------------------------------------------------
# Slack or Discord incoming webhook. Receives 5xx bursts, thrown handlers and
# webhook processing failures, deduplicated for ten minutes per cause.
# ALERT_WEBHOOK_URL=

# Guards /api/metrics. Leave unset for public metrics (they contain no PII).
# Set it if you would rather competitors could not read your run counts.
# METRICS_TOKEN=

# Structured log level: debug | info | warn | error
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# 7. Scheduled jobs
# -----------------------------------------------------------------------------
# Required for GET /api/cron/purge to do anything. Vercel Cron sends this
# automatically as a Bearer token once it is set on the project. Without it the
# route refuses to run rather than exposing a destructive endpoint.
# CRON_SECRET=

# How long metered usage rows are kept. Longer than everything else because they
# are the evidence behind an invoice.
USAGE_RETENTION_DAYS=400

# How long an anonymous caller's IP is kept on a usage row before being nulled.
# The row survives; only the identifier goes. An IP is recorded solely to enforce
# the daily anonymous allowance, which resets every day, so holding it for the
# full usage retention would be personal data kept long past its purpose.
IP_RETENTION_DAYS=30

# -----------------------------------------------------------------------------
# 8. Legacy / escape hatch
# -----------------------------------------------------------------------------
# Static comma-separated API keys. Only consulted when DATABASE_URL is UNSET, as
# the fastest way to lock the endpoint before you have a database. With a database
# configured, real per-user keys from the dashboard are used instead.
# API_KEYS=

# Public site URL, used for canonical + Open Graph tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comma separated API keys. Leave EMPTY to keep /api/v1/run open (good for launch-day demos).
# Set it before you start charging.
API_KEYS=

# Requests per minute, per API key or IP. 0 disables the limiter.
RATE_LIMIT_PER_MIN=60
